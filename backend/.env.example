# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB Database Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/market_ecommerce?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=super_secret_jwt_private_key_change_in_production_998877
JWT_EXPIRES_IN=7d

# Cloudinary Storage for Images (Optional / Recommended)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
